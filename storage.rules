rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 1. Доклади (Reports)
    match /reports/{fileName} {
      allow read;
      allow write: if request.auth != null;
    }

    // 2. Събития (Events)
    match /events/{fileName} {
      allow read;
      allow write: if request.auth != null;
    }

    // 3. Профилни снимки
    match /profile_pictures/{fileName} {
      allow read;
      allow write: if request.auth != null;
    }

    // 4. Снимки в чат
    match /chat_images/{channelId}/{fileName} {
      allow read;
      allow write: if request.auth != null;
    }

    // 5. Потребителски файлове (AI албум и др.)
    // Примерен път: users/USER_ID/animals/UUID.jpg
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
