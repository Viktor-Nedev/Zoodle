rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(userId);

      match /album/{albumId} {
        allow read: if signedIn();
        allow create, update, delete: if isOwner(userId);
      }
    }

    match /chats/{chatId} {
      allow create: if signedIn() &&
          request.resource.data.members is list &&
          request.auth.uid in request.resource.data.members;
      allow read, update, delete: if signedIn() &&
          request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        allow read, create, update, delete: if signedIn() &&
            request.auth.uid in
            get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }

    match /event_channels/{channelId} {
      allow create: if signedIn() &&
          request.resource.data.members is list &&
          request.auth.uid in request.resource.data.members;
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn() &&
          (
            request.auth.uid in resource.data.members ||
            (
              request.resource.data.members is list &&
              request.auth.uid in request.resource.data.members
            )
          );
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        allow read, create, update, delete: if signedIn() &&
            request.auth.uid in
            get(/databases/$(database)/documents/event_channels/$(channelId)).data.members;
      }

      match /user_settings/{userId} {
        allow read, create, update, delete: if isOwner(userId) &&
            request.auth.uid in
            get(/databases/$(database)/documents/event_channels/$(channelId)).data.members;
      }
    }

    match /animal_reports/{reportId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow create: if signedIn();
      allow read, update, delete: if signedIn() &&
          request.auth.uid == resource.data.userId;
    }

    match /group_invitations/{inviteId} {
      allow create: if signedIn() &&
          request.resource.data.inviterId == request.auth.uid;
      allow read: if signedIn() &&
          (
            resource.data.inviterId == request.auth.uid ||
            resource.data.inviteeId == request.auth.uid
          );
      allow update, delete: if signedIn() &&
          (
            resource.data.inviterId == request.auth.uid ||
            resource.data.inviteeId == request.auth.uid
          );
    }

    match /chat_reports/{reportId} {
      allow create: if signedIn();
      allow read, update, delete: if false;
    }
  }
}
